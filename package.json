{
  "name": "clashscout",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de recrutamento para Clash of Clans - conecta jogadores (curriculos) a lideres de cla (vagas).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace @clashscout/web",
    "dev:api": "npm run dev --workspace @clashscout/api",
    "build": "npm run build:api && npm run build:web",
    "build:shared": "npm run build --workspace @clashscout/shared",
    "build:database": "npm run build --workspace @clashscout/database",
    "build:web": "npm run build:database && npm run build --workspace @clashscout/web",
    "build:api": "npm run build:shared && npm run build:database && npm run build --workspace @clashscout/api",
    "start:api": "npm run start:prod --workspace @clashscout/api",
    "migrate:deploy": "npm run migrate:deploy --workspace @clashscout/database",
    "migrate:dev": "npm run migrate:dev --workspace @clashscout/database",
    "migrate:status": "npm run migrate:status --workspace @clashscout/database",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2"
  }
}
