# ---------------------------------------------------------------------------
# ClashScout Web - variaveis de ambiente
# Copie para .env.local (local) ou configure no painel da Vercel (producao).
# Prefixo NEXT_PUBLIC_ = exposto ao browser. Nunca coloque segredos aqui.
# ---------------------------------------------------------------------------

# URL publica da API no Railway (sem barra no final)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Chave publica VAPID para Web Push (Fase 4)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
