# ---------------------------------------------------------------------------
# ClashScout Web - variaveis de ambiente
# Copie para .env.local (local) ou configure no painel da Vercel (producao).
# Prefixo NEXT_PUBLIC_ = exposto ao browser. Nunca coloque segredos nele.
# ---------------------------------------------------------------------------

# URL publica da API no Railway (sem barra no final)
NEXT_PUBLIC_API_URL=http://localhost:3333

# ---------------------------------------------------------------------------
# Auth.js (NextAuth v5) - tudo aqui e server-side
# ---------------------------------------------------------------------------
# Segredo de assinatura de cookies. Gere com: npx auth secret
AUTH_SECRET=

# URL canonica da aplicacao. Necessaria para o callback do OAuth.
# Na Vercel e detectada automaticamente; defina apenas em dev.
AUTH_URL=http://localhost:3000

# Credenciais OAuth do Google Cloud Console.
# Redirect URI autorizada: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
# O app web toca o banco APENAS para as tabelas do Auth.js
# (User/Account/Session). Todo o dominio passa pela API.
# Use a DATABASE_PUBLIC_URL do Postgres do Railway: a Vercel esta fora da
# rede privada do Railway e nao resolve o host interno.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Push Notifications (Fase 4)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
