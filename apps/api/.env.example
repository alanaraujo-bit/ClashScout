# ---------------------------------------------------------------------------
# ClashScout API - variaveis de ambiente
# Copie para .env (local) ou configure no painel do Railway (producao).
# Nenhum valor real deve ser commitado.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
# O Railway injeta PORT automaticamente. Localmente usamos 3333.
PORT=3333

# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Banco de dados PostgreSQL
# ---------------------------------------------------------------------------
# No Railway use a referencia: ${{Postgres.DATABASE_URL}} (host interno).
# Localmente use a DATABASE_PUBLIC_URL do painel: o host .railway.internal
# so resolve de dentro da rede do Railway.
DATABASE_URL=postgresql://user:password@localhost:5432/clashscout?schema=public

# ---------------------------------------------------------------------------
# API oficial da Supercell
# ---------------------------------------------------------------------------
SUPERCELL_API_BASE_URL=https://api.clashofclans.com/v1

# Token de desenvolvedor gerado em https://developer.clashofclans.com
# ATENCAO: o token e vinculado a uma allowlist de IPs. Ver docs/SUPERCELL.md.
SUPERCELL_API_TOKEN=

# TTL do cache de perfil, em segundos. Protege o rate limit da Supercell:
# leituras repetidas da mesma tag dentro da janela nao geram requisicao.
SUPERCELL_CACHE_TTL_SECONDS=600

# Teto de requisicoes por segundo enviadas a Supercell.
SUPERCELL_RATE_LIMIT_PER_SECOND=10

# Timeout de cada chamada HTTP a Supercell, em milissegundos.
SUPERCELL_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Web Push (Fase 4)
# ---------------------------------------------------------------------------
# Gere o par com: node -e "console.log(require('web-push').generateVAPIDKeys())"
# VAPID_PUBLIC_KEY tambem vai na Vercel, como NEXT_PUBLIC_VAPID_PUBLIC_KEY (mesmo valor).
# Sem as duas chaves, o envio de push vira um no-op logado - a API sobe normalmente.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@clashscout.app
